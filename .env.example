# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_token_here

# PostgreSQL Database URL (optional - falls back to JSON file storage)
# Get this from Railway when you add a PostgreSQL plugin
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# WhatsApp Bot (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=porto-transport-bot
WHATSAPP_PORT=8080

# Meta App Secret. REQUIRED in production: every inbound webhook is
# authenticated with an HMAC over the raw body, and without this the
# webhook rejects every POST (fails closed). Without that check, anyone
# who finds the webhook URL can make the bot message arbitrary numbers.
WHATSAPP_APP_SECRET=

# Local development only - accepts unsigned webhooks so you can curl them.
# Ignored once WHATSAPP_APP_SECRET is set. Never enable in production.
# WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=true
